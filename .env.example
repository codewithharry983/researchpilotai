# ==============================================================================
# ResearchPilot AI — Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application & URLs
APP_NAME=ResearchPilot AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Security & Sessions
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=rp_access_token
COOKIE_SECURE=false

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///./researchpilot.db

# Docker / Production (PostgreSQL with pgvector):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/researchpilot

# AI & LLM Provider Configuration
# Supported providers: "auto", "openai", "gemini", or "offline"
# In "auto" or "offline" mode without keys, a deterministic grounded engine answers queries strictly from document evidence.
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# API Keys (Provide one if using commercial cloud providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=

# Text-to-Speech (TTS) Provider for ResearchPilot Studio
# Supported: "edge-tts" (free, zero-config Microsoft Neural voices) or "openai" (requires OPENAI_API_KEY)
TTS_PROVIDER=edge-tts

# Vector Embeddings
# Supported providers: "auto", "openai", "gemini", "offline"
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# Document Ingestion & Chunking
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Hybrid Retrieval (RAG)
TOP_K=5
SIMILARITY_THRESHOLD=0.35
KEYWORD_SEARCH_WEIGHT=0.4
VECTOR_SEARCH_WEIGHT=0.6
ENABLE_RERANKING=false

# Rate Limits (Requests per minute)
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=25
